{
  "name": "restaurant-pos-mobile",
  "version": "2.0.0",
  "description": "Enterprise Restaurant POS Mobile Application",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace RestaurantPOS.xcworkspace -scheme RestaurantPOS -configuration Release"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.13",
    "@react-navigation/native-stack": "^7.1.10",
    "@react-navigation/bottom-tabs": "^7.1.10",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.12.2",
    "react": "18.3.1",
    "react-native": "0.77.4",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.5.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "^3.18.0",
    "socket.io-client": "^4.8.1",
    "@react-native-async-storage/async-storage": "^2.1.1",
    "react-native-toast-message": "^3.1.0",
    "react-native-camera": "^4.2.1",
    "react-native-qrcode-scanner": "^1.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native/eslint-config": "^0.77.4",
    "@react-native/metro-config": "^0.77.4",
    "@react-native/typescript-config": "^0.77.4",
    "@types/react": "^18.3.18",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^30.2.0",
    "eslint": "^9.22.0",
    "jest": "^30.2.0",
    "prettier": "^3.5.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
